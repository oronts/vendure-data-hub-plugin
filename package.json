{
  "name": "@oronts/vendure-data-hub-plugin",
  "version": "0.1.7",
  "description": "ETL data integration plugin for Vendure e-commerce",
  "author": {
    "name": "Oronts Website",
    "email": "office@oronts.com",
    "url": "https://oronts.com"
  },
  "contributors": [
    {
      "name": "Refaat Al Ktifan",
      "email": "Refaat@alktifan.com"
    }
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk/index.d.ts",
      "require": "./dist/src/sdk/index.js",
      "default": "./dist/src/sdk/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "require": "./dist/shared/index.js",
      "default": "./dist/shared/index.js"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "require": "./dist/connectors/index.js",
      "default": "./dist/connectors/index.js"
    },
    "./connectors/pimcore": {
      "types": "./dist/connectors/pimcore/index.d.ts",
      "require": "./dist/connectors/pimcore/index.js",
      "default": "./dist/connectors/pimcore/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist/shared/**/*.js",
    "dist/shared/**/*.d.ts",
    "dist/connectors/**/*.js",
    "dist/connectors/**/*.d.ts",
    "dist/dashboard/**/*.ts",
    "dist/dashboard/**/*.tsx",
    "dist/dashboard/styles.css",
    "dist/dashboard/i18n/*.po",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONFIGURATION.md",
    "SECURITY.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "vendure",
    "vendure-plugin",
    "etl",
    "data-integration",
    "pipeline",
    "data-hub",
    "product-feed",
    "google-shopping",
    "facebook-catalog",
    "amazon-feed",
    "import",
    "export",
    "transform"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oronts/vendure-data-hub-plugin.git"
  },
  "homepage": "https://oronts.com",
  "bugs": {
    "url": "https://github.com/oronts/vendure-data-hub-plugin/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names vendure,dashboard --prefix-colors blue,magenta \"npm run start\" \"npm run dev:dashboard\"",
    "dev:dashboard": "vite --config vite.dev.config.mts",
    "start": "ts-node dev-server/index.ts",
    "populate": "ts-node dev-server/populate.ts",
    "typecheck:dev": "tsc -p tsconfig.dev.json",
    "build": "rimraf dist && npm run compile && npm run copy:dashboard && npm run build:dashboard",
    "build:dev": "vite build --config vite.dev.config.mts",
    "build:dashboard": "vite build",
    "compile": "tsc -p tsconfig.build.json",
    "compile:watch": "tsc -p tsconfig.build.json --watch",
    "copy:dashboard": "ts-node scripts/copy-dashboard.ts",
    "clean": "rimraf dist .dashboard-build",
    "typecheck": "tsc --noEmit",
    "typecheck:dashboard": "ts-node scripts/typecheck-dashboard.ts",
    "lint": "eslint --ext .ts,.tsx,.mts src shared connectors dashboard dev-server e2e scripts vendure-config.dev.ts codegen.ts vite.config.mts vite.dev.config.mts",
    "lint:fix": "npm run lint -- --fix",
    "i18n:extract": "lingui extract --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:infrastructure:redis:standalone": "sh scripts/test-redis-distributed.sh",
    "test:infrastructure:redis:sentinel": "sh scripts/test-redis-sentinel.sh",
    "test:infrastructure:redis": "npm run test:infrastructure:redis:standalone && npm run test:infrastructure:redis:sentinel",
    "test:infrastructure:otlp": "node scripts/verify-otlp-collector.mjs",
    "test:infrastructure:external": "bash scripts/run-external-protocol-tests.sh",
    "test:infrastructure": "npm run test:infrastructure:redis && npm run test:infrastructure:otlp && npm run test:infrastructure:external",
    "verify:package": "ts-node scripts/verify-package.ts",
    "verify:docs": "npm run schema && ts-node scripts/verify-doc-imports.ts",
    "verify:i18n": "ts-node scripts/verify-i18n.ts",
    "prepack": "npm run build",
    "schema": "ts-node scripts/generate-schema.ts",
    "codegen": "ts-node scripts/generate-shared-enums.ts && npm run schema && graphql-codegen --config codegen.ts",
    "codegen:watch": "npm run schema && ts-node scripts/generate-shared-enums.ts && graphql-codegen --config codegen.ts --watch"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": ">=3.0.0 <4.0.0",
    "@graphql-typed-document-node/core": ">=3.2.0 <4.0.0",
    "@lingui/core": ">=5.7.0 <6.0.0",
    "@lingui/react": ">=5.7.0 <6.0.0",
    "@tanstack/react-query": ">=5.66.7 <6.0.0",
    "@tanstack/react-router": ">=1.154.0 <2.0.0",
    "@tanstack/react-table": ">=8.21.2 <9.0.0",
    "@vendure/core": ">=3.5.7 <3.6.0",
    "@vendure/dashboard": ">=3.5.7 <3.6.0",
    "lucide-react": ">=0.475.0 <1.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "sonner": ">=2.0.6 <3.0.0",
    "typeorm": ">=0.3.29 <0.4.0"
  },
